#!/bin/sh
# Installed as /usr/bin/passt; the real binary is diverted to passt.distrib.
#
# For a krun VM with krun.use_passt=1, crun starts /usr/bin/passt from inside
# this image, always with --no-map-gw, which leaves the guest no way to reach
# the container's loopback -- where pasta's -T forwards to the host listen.
# --map-host-loopback maps one address there, and sandbx-vm-net sends the
# guest's 127.0.0.1:30000-30009 to it. Only those forwards (and passt's own
# listeners, which lead back into the guest) live on that loopback, so the
# host stays reachable on the reserved ports only.
#
# Must match VM_HOST_LOOPBACK in sandbx.py.
exec /usr/bin/passt.distrib "$@" --map-host-loopback 169.254.30.1
