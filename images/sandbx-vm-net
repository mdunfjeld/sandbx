#!/bin/sh
# usage: sandbx-vm-net ADDR FIRST-LAST -- COMMAND [ARG...]
#
# Runs as root at the start of every krun VM, before setpriv drops to agent.
# With virtio-net (krun.use_passt) the guest's 127.0.0.1 is its own, so
# 127.0.0.1:FIRST-LAST would reach nothing. This DNATs those TCP ports to ADDR,
# which passt (see passt-wrapper) maps to the container's loopback, where
# pasta forwards them to the host. The guest then sees the host ports exactly
# as a crun container does. A failure only costs those ports, so it warns and
# starts COMMAND anyway.

if [ "$#" -lt 4 ] || [ "$3" != "--" ]; then
    echo "usage: sandbx-vm-net ADDR FIRST-LAST -- COMMAND [ARG...]" >&2
    exit 2
fi
addr=$1
ports=$2
shift 3

route_to_host() {
    # Lets packets from 127.0.0.1 leave through eth0 once DNAT has rewritten
    # their destination; masquerade then gives them eth0's address.
    echo 1 2>/dev/null >/proc/sys/net/ipv4/conf/all/route_localnet || return 1
    nft -f - <<EOF
table ip sandbx {
    chain output {
        type nat hook output priority dstnat;
        ip daddr 127.0.0.1 tcp dport $ports dnat to $addr
    }
    chain postrouting {
        type nat hook postrouting priority srcnat;
        ip saddr 127.0.0.1 ip daddr $addr masquerade
    }
}
EOF
}

route_to_host || echo "sandbx-vm-net: 127.0.0.1:$ports will not reach the host" >&2
exec "$@"
